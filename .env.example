# ─────────────────────────────────────────────────────────────
# kbot 환경 변수 — 이 파일을 .env 로 복사해 값을 채우세요.
# .env 는 git에 올라가지 않습니다. API 키를 코드·로그·프롬프트에 넣지 마세요.
# ─────────────────────────────────────────────────────────────

# 실행 모드: paper(모의투자, 기본) | live(실거래 — 현재 미구현, 켜도 거부됨)
TRADING_MODE=paper

# 데이터 디렉터리 (SQLite DB, 토큰 캐시 등)
KBOT_DATA_DIR=./var

# ── Anthropic (이 봇 전용 키) ───────────────────────────────
ANTHROPIC_API_KEY=
# 월 LLM 예산(USD) 하드 제한
LLM_MONTHLY_BUDGET_USD=150
# 월 리셋 기준일 (요금제 결제일, 1~31; 그 달에 없는 날이면 말일)
LLM_BUDGET_RESET_DAY=1

# ── 한국투자증권 KIS Open API (모의투자) ─────────────────────
KIS_PAPER_APP_KEY=
KIS_PAPER_APP_SECRET=
# 모의투자 계좌번호 앞 8자리 / 뒤 2자리(상품코드, 보통 01)
KIS_PAPER_ACCOUNT_NO=
KIS_PAPER_ACCOUNT_PRODUCT=01

# ── DART OpenAPI (https://opendart.fss.or.kr) ──────────────
DART_API_KEY=

# ── SEC EDGAR: 연락처가 담긴 User-Agent 필수 (예: "Your Name your@email.com")
SEC_USER_AGENT=

# ── 한국은행 ECOS (원/달러 매매기준율) ─────────────────────
ECOS_API_KEY=

# ── KRX 정보데이터시스템 계정 (pykrx 수급·공매도 데이터용) ──
KRX_ID=
KRX_PW=

# ── 디스코드 알림 웹훅 (예산 경고 등) ─────────────────────
DISCORD_WEBHOOK_URL=
